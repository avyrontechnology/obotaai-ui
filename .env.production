# Public build-time defaults for production builds (Vercel prod + previews).
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put secrets here.
# Values set in the deployment environment (Vercel → Settings → Environment
# Variables) override these. next.config.ts proxies the API at /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://engine.143-110-255-238.sslip.io/api/v1
NEXT_PUBLIC_WS_BASE_URL=wss://engine.143-110-255-238.sslip.io
